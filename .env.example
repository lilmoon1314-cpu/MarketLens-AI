# Configuration contract for later features; F00 does not load this file yet.
# Copy to .env locally. Never commit credentials or browser session files.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

GLINER_MODEL_ID=fastino/gliner2-multi-v1
GLINER_DEVICE=cpu
GLINER_BATCH_SIZE=8

# Persistent browser profile for the future Taobao collector.
# Login is completed locally in the browser; do not put passwords here.
TAOBAO_PROFILE_DIR=.local/taobao-profile
MARKETLENS_DATA_DIR=.local
