# Copy this template to ignored .env. LLM configuration is loaded by F07.
# Copy to .env locally. Never commit credentials or browser session files.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# json_mode is the default; json_schema requires provider support.
LLM_STRUCTURED_METHOD=json_mode
LLM_CONTEXT_TOKENS=16000
LLM_INPUT_TOKENS=8000
LLM_OUTPUT_TOKENS=2000
LLM_RUN_TOKENS=60000

GLINER_MODEL_ID=fastino/gliner2-multi-v1
GLINER_DEVICE=cpu
GLINER_BATCH_SIZE=8

# Persistent browser profile for the future Taobao collector.
# Login is completed locally in the browser; do not put passwords here.
TAOBAO_PROFILE_DIR=.local/taobao-profile
MARKETLENS_DATA_DIR=.local
