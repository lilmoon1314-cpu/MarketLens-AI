{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Insight": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "strength",
            "weakness",
            "pain_point",
            "feature_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "hypothesis": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hypothesis"
        }
      },
      "required": [
        "kind",
        "title",
        "summary",
        "evidence_ids",
        "hypothesis"
      ],
      "title": "Insight",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "maxLength": 4000,
      "title": "Summary",
      "type": "string"
    },
    "insights": {
      "items": {
        "$ref": "#/$defs/Insight"
      },
      "maxItems": 20,
      "title": "Insights",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 1000,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "insights",
    "limitations"
  ],
  "title": "AnalystOutput",
  "type": "object"
}
