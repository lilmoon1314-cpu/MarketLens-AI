{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "goal": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "sources": {
          "items": {
            "enum": [
              "local",
              "taobao"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array",
          "uniqueItems": true
        },
        "dataset_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset Id"
        },
        "product_urls": {
          "items": {
            "format": "uri",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Product Urls",
          "type": "array",
          "uniqueItems": true
        },
        "max_reviews": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Reviews",
          "type": "integer"
        },
        "report_language": {
          "enum": [
            "zh-CN",
            "en"
          ],
          "title": "Report Language",
          "type": "string"
        }
      },
      "required": [
        "product",
        "goal",
        "sources",
        "dataset_id",
        "product_urls",
        "max_reviews",
        "report_language"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    },
    "AnalystOutput": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        },
        "insights": {
          "items": {
            "$ref": "#/$defs/Insight"
          },
          "maxItems": 20,
          "title": "Insights",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 1000,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "insights",
        "limitations"
      ],
      "title": "AnalystOutput",
      "type": "object"
    },
    "BoundChart": {
      "additionalProperties": false,
      "properties": {
        "chart": {
          "enum": [
            "bar",
            "donut"
          ],
          "title": "Chart",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "dataset": {
          "enum": [
            "sentiment_distribution",
            "topic_distribution",
            "feedback_value_distribution",
            "insight_evidence_counts"
          ],
          "title": "Dataset",
          "type": "string"
        },
        "x": {
          "const": "label",
          "title": "X",
          "type": "string"
        },
        "y": {
          "const": "count",
          "title": "Y",
          "type": "string"
        },
        "data": {
          "items": {
            "$ref": "#/$defs/ChartRow"
          },
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "chart",
        "title",
        "dataset",
        "x",
        "y",
        "data"
      ],
      "title": "BoundChart",
      "type": "object"
    },
    "ChartRow": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "count"
      ],
      "title": "ChartRow",
      "type": "object"
    },
    "ChartSpec": {
      "additionalProperties": false,
      "properties": {
        "chart": {
          "enum": [
            "bar",
            "donut"
          ],
          "title": "Chart",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "dataset": {
          "enum": [
            "sentiment_distribution",
            "topic_distribution",
            "feedback_value_distribution",
            "insight_evidence_counts"
          ],
          "title": "Dataset",
          "type": "string"
        },
        "x": {
          "const": "label",
          "title": "X",
          "type": "string"
        },
        "y": {
          "const": "count",
          "title": "Y",
          "type": "string"
        }
      },
      "required": [
        "chart",
        "title",
        "dataset",
        "x",
        "y"
      ],
      "title": "ChartSpec",
      "type": "object"
    },
    "Insight": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "strength",
            "weakness",
            "pain_point",
            "feature_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "hypothesis": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hypothesis"
        }
      },
      "required": [
        "kind",
        "title",
        "summary",
        "evidence_ids",
        "hypothesis"
      ],
      "title": "Insight",
      "type": "object"
    },
    "JsonValue": {},
    "Notice": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "retryable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retryable"
        }
      },
      "required": [
        "code",
        "stage",
        "message"
      ],
      "title": "Notice",
      "type": "object"
    },
    "PlannerOutput": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "enum": [
              "local",
              "taobao"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array",
          "uniqueItems": true
        },
        "keywords": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Keywords",
          "type": "array",
          "uniqueItems": true
        },
        "dimensions": {
          "items": {
            "enum": [
              "strength",
              "weakness",
              "pain_point",
              "feature_request"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Dimensions",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "sources",
        "keywords",
        "dimensions"
      ],
      "title": "PlannerOutput",
      "type": "object"
    },
    "ReportInsight": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "strength",
            "weakness",
            "pain_point",
            "feature_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "hypothesis": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hypothesis"
        },
        "insight_id": {
          "minLength": 1,
          "title": "Insight Id",
          "type": "string"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "title",
        "summary",
        "evidence_ids",
        "hypothesis",
        "insight_id",
        "evidence_count"
      ],
      "title": "ReportInsight",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "valid_count": {
          "minimum": 0,
          "title": "Valid Count",
          "type": "integer"
        },
        "strict_cap": {
          "minimum": 0,
          "title": "Strict Cap",
          "type": "integer"
        },
        "candidate_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "selected_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Ids",
          "type": "array"
        },
        "batches": {
          "items": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "title": "Batches",
          "type": "array"
        },
        "batch_estimated_input_tokens": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Batch Estimated Input Tokens",
          "type": "array"
        },
        "estimated_run_tokens": {
          "minimum": 0,
          "title": "Estimated Run Tokens",
          "type": "integer"
        },
        "token_count_method": {
          "const": "estimated_utf8_bytes",
          "title": "Token Count Method",
          "type": "string"
        },
        "unselected_candidate_count": {
          "minimum": 0,
          "title": "Unselected Candidate Count",
          "type": "integer"
        },
        "token_skipped_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Token Skipped Ids",
          "type": "array"
        },
        "method": {
          "const": "topic_stratified_largest_remainder",
          "title": "Method",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "valid_count",
        "strict_cap",
        "candidate_ids",
        "selected_ids",
        "batches",
        "batch_estimated_input_tokens",
        "estimated_run_tokens",
        "token_count_method",
        "unselected_candidate_count",
        "token_skipped_ids",
        "method",
        "threshold"
      ],
      "title": "Selection",
      "type": "object"
    },
    "Statistics": {
      "additionalProperties": false,
      "properties": {
        "raw_count": {
          "minimum": 0,
          "title": "Raw Count",
          "type": "integer"
        },
        "valid_count": {
          "minimum": 0,
          "title": "Valid Count",
          "type": "integer"
        },
        "rejected_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Rejected Counts",
          "type": "object"
        },
        "annotated_count": {
          "minimum": 0,
          "title": "Annotated Count",
          "type": "integer"
        },
        "unprocessed_count": {
          "minimum": 0,
          "title": "Unprocessed Count",
          "type": "integer"
        },
        "unknown_count": {
          "minimum": 0,
          "title": "Unknown Count",
          "type": "integer"
        },
        "spam_count": {
          "minimum": 0,
          "title": "Spam Count",
          "type": "integer"
        },
        "truncated_count": {
          "minimum": 0,
          "title": "Truncated Count",
          "type": "integer"
        },
        "low_sample": {
          "title": "Low Sample",
          "type": "boolean"
        },
        "product_denominator": {
          "minimum": 0,
          "title": "Product Denominator",
          "type": "integer"
        },
        "value_denominator": {
          "minimum": 0,
          "title": "Value Denominator",
          "type": "integer"
        },
        "sentiment_distribution": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "positive",
              "negative",
              "neutral",
              "mixed",
              "unknown"
            ]
          },
          "title": "Sentiment Distribution",
          "type": "object"
        },
        "topic_distribution": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Topic Distribution",
          "type": "object"
        },
        "feedback_value_distribution": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "actionable",
              "non_actionable",
              "spam",
              "unknown"
            ]
          },
          "title": "Feedback Value Distribution",
          "type": "object"
        }
      },
      "required": [
        "raw_count",
        "valid_count",
        "rejected_counts",
        "annotated_count",
        "unprocessed_count",
        "unknown_count",
        "spam_count",
        "truncated_count",
        "low_sample",
        "product_denominator",
        "value_denominator",
        "sentiment_distribution",
        "topic_distribution",
        "feedback_value_distribution"
      ],
      "title": "Statistics",
      "type": "object"
    },
    "VisualizationOutput": {
      "additionalProperties": false,
      "properties": {
        "charts": {
          "items": {
            "$ref": "#/$defs/ChartSpec"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Charts",
          "type": "array"
        }
      },
      "required": [
        "charts"
      ],
      "title": "VisualizationOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "insufficient_data",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "mode": {
      "enum": [
        "demo",
        "real"
      ],
      "title": "Mode",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/AnalysisRequest"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlannerOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_count": {
      "minimum": 0,
      "title": "Review Count",
      "type": "integer"
    },
    "raw_count": {
      "minimum": 0,
      "title": "Raw Count",
      "type": "integer"
    },
    "rejected_counts": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Rejected Counts",
      "type": "object"
    },
    "selected_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Selected Ids",
      "type": "array"
    },
    "statistics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Statistics"
        },
        {
          "type": "null"
        }
      ]
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/Selection"
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metrics",
      "type": "object"
    },
    "analyst_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalystOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "insights": {
      "items": {
        "$ref": "#/$defs/ReportInsight"
      },
      "title": "Insights",
      "type": "array"
    },
    "visualization": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisualizationOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "charts": {
      "items": {
        "$ref": "#/$defs/BoundChart"
      },
      "title": "Charts",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Notice"
      },
      "title": "Warnings",
      "type": "array"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/Notice"
      },
      "title": "Errors",
      "type": "array"
    },
    "persisted": {
      "default": false,
      "title": "Persisted",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "mode",
    "request",
    "plan",
    "review_count",
    "raw_count",
    "rejected_counts",
    "selected_ids",
    "statistics",
    "selection",
    "metrics",
    "analyst_result",
    "insights",
    "visualization",
    "charts",
    "warnings",
    "errors"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
